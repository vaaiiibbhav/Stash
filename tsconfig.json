{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true
  },
  /* The app's UI is F#/Fable — the only TypeScript left in the repo is the
     Vite config, which tsconfig.node.json owns. */
  "include": ["src/**/*.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
