# ------------------------------------------------------------------
# Stash — environment template
#
# Copy this file to `.env.local` and fill in real values there.
# `.env.local` is gitignored; NEVER commit real keys or secrets.
# Only variables prefixed with VITE_ are exposed to the frontend
# (see envPrefix in vite.config.ts) — treat anything VITE_* as public.
# ------------------------------------------------------------------

# App metadata surfaced in the UI (safe to expose)
VITE_APP_NAME=Stash

# Example placeholder for a future backend/telemetry endpoint.
# Leave empty if unused. Do NOT put private keys in VITE_* variables.
VITE_API_BASE_URL=

# --- Tauri release signing (used by CI / `tauri build`, backend-only) ---
# Path to or content of the updater private key. Keep out of the repo.
# TAURI_PRIVATE_KEY=
# TAURI_KEY_PASSWORD=
